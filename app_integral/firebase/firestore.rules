rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function anonymousRsvpUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function weddingPath(weddingId) {
      return /databases/$(database)/documents/weddings/$(weddingId);
    }

    function memberPath(weddingId) {
      return /databases/$(database)/documents/weddings/$(weddingId)/members/$(request.auth.uid);
    }

    function hasActiveMembership(weddingId) {
      return signedIn()
        && exists(memberPath(weddingId))
        && get(memberPath(weddingId)).data.get('status', 'active') == 'active';
    }

    function memberRole(weddingId) {
      return hasActiveMembership(weddingId)
        ? get(memberPath(weddingId)).data.get('role', 'viewer')
        : 'none';
    }

    function isOwner(weddingId) {
      return memberRole(weddingId) == 'owner';
    }

    function isAdmin(weddingId) {
      return memberRole(weddingId) == 'admin';
    }

    function canManageTeam(weddingId) {
      return memberRole(weddingId) in ['owner', 'admin'];
    }

    function canEditPlanner(weddingId) {
      return memberRole(weddingId) in ['owner', 'admin', 'editor'];
    }

    function isValidCollaboratorRole(role) {
      return role in ['admin', 'editor', 'provider', 'viewer'];
    }

    function invitationPath(weddingId) {
      return /databases/$(database)/documents/invitations/$(weddingId + '__' + authEmail());
    }

    function hasPendingInvitation(weddingId) {
      return signedIn()
        && authEmail() != ''
        && exists(invitationPath(weddingId))
        && get(invitationPath(weddingId)).data.get('status', '') == 'pending'
        && get(invitationPath(weddingId)).data.get('email', '') == authEmail();
    }

    function pendingInvitationRole(weddingId) {
      return hasPendingInvitation(weddingId)
        ? get(invitationPath(weddingId)).data.get('role', 'viewer')
        : 'none';
    }

    function isOwnerBootstrap(weddingId, memberUid) {
      return signedIn()
        && memberUid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && getAfter(weddingPath(weddingId)).data.ownerUid == request.auth.uid;
    }

    function publicRsvpPath(token) {
      return /databases/$(database)/documents/publicRsvp/$(token);
    }

    function publicRsvpExists(token) {
      return exists(publicRsvpPath(token));
    }

    function publicRsvpWedding(token) {
      return get(publicRsvpPath(token)).data.get('weddingId', '');
    }

    function publicRsvpActive(token) {
      return publicRsvpExists(token)
        && get(publicRsvpPath(token)).data.get('active', false) == true;
    }

    function publicRsvpMaxGuests(token) {
      return get(publicRsvpPath(token)).data.get('maxGuests', 1);
    }

    function validRsvpSubmission(token) {
      return request.resource.data.keys().hasOnly([
          'version',
          'name',
          'attendance',
          'quantity',
          'companions',
          'menu',
          'email',
          'phone',
          'restriction',
          'notes',
          'customData',
          'ownerUid',
          'clientDate',
          'source',
          'submittedAt',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.attendance in ['confirmed', 'declined', 'tentative']
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= publicRsvpMaxGuests(token)
        && (
          (request.resource.data.attendance == 'declined' && request.resource.data.quantity == 0)
          || (request.resource.data.attendance != 'declined' && request.resource.data.quantity >= 1)
        )
        && request.resource.data.companions is list
        && request.resource.data.companions.size() <= publicRsvpMaxGuests(token)
        && request.resource.data.menu is string
        && request.resource.data.menu.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 60
        && request.resource.data.restriction is string
        && request.resource.data.restriction.size() <= 160
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 700
        && request.resource.data.customData is map
        && request.resource.data.customData.keys().size() <= 15
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.clientDate is string
        && request.resource.data.clientDate.size() <= 60
        && request.resource.data.source == 'public-rsvp';
    }

    // Permite que la encuesta de música exista antes del RSVP. El documento
    // usa el mismo token + responseId y después se completa mediante merge
    // cuando el invitado confirma su asistencia.
    function validMusicOnlySubmission(token) {
      return request.resource.data.keys().hasOnly([
          'version',
          'source',
          'customData',
          'ownerUid',
          'clientDate',
          'submittedAt',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.source == 'music-widget'
        && request.resource.data.customData is map
        && request.resource.data.customData.keys().hasOnly(['mgdMusic'])
        && request.resource.data.customData.mgdMusic is string
        && request.resource.data.customData.mgdMusic.size() > 0
        && request.resource.data.customData.mgdMusic.size() <= 8000
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.clientDate is string
        && request.resource.data.clientDate.size() <= 60;
    }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /weddings/{weddingId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if hasActiveMembership(weddingId);
      allow update, delete: if isOwner(weddingId);

      match /members/{memberUid} {
        allow read: if hasActiveMembership(weddingId);

        allow create: if isOwner(weddingId)
          || isOwnerBootstrap(weddingId, memberUid)
          || (
            signedIn()
            && memberUid == request.auth.uid
            && hasPendingInvitation(weddingId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == authEmail()
            && request.resource.data.role == pendingInvitationRole(weddingId)
            && isValidCollaboratorRole(request.resource.data.role)
            && request.resource.data.status == 'active'
          );

        allow update: if (
            isOwner(weddingId)
            && resource.data.role != 'owner'
            && isValidCollaboratorRole(request.resource.data.role)
          ) || (
            isAdmin(weddingId)
            && resource.data.role in ['editor', 'provider', 'viewer']
            && request.resource.data.role in ['editor', 'provider', 'viewer']
          );

        allow delete: if isOwner(weddingId)
          || (
            isAdmin(weddingId)
            && resource.data.role in ['editor', 'provider', 'viewer']
          )
          || (signedIn() && memberUid == request.auth.uid && resource.data.role != 'owner');
      }

      match /cloudSync/{syncId} {
        allow read: if hasActiveMembership(weddingId);
        allow write: if canEditPlanner(weddingId);
      }

      match /cloudChunks/{chunkId} {
        allow read: if hasActiveMembership(weddingId);
        allow write: if canEditPlanner(weddingId);
      }

      match /rsvpConfig/{configId} {
        allow read: if hasActiveMembership(weddingId);
        allow create, update, delete: if canEditPlanner(weddingId);
      }

      // Metadatos privados de revisión del RSVP: etiquetas, lado de los novios
      // y vínculos manuales con invitados existentes. Nunca se exponen al invitado público.
      match /rsvpManagement/{managementId} {
        allow read: if hasActiveMembership(weddingId);
        allow create, update, delete: if canEditPlanner(weddingId);
      }
    }

    match /invitations/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && isValidCollaboratorRole(request.resource.data.role)
        && request.resource.data.status == 'pending'
        && canManageTeam(request.resource.data.weddingId)
        && (request.resource.data.role != 'admin' || isOwner(request.resource.data.weddingId));

      allow read: if signedIn()
        && (
          resource.data.email == authEmail()
          || canManageTeam(resource.data.weddingId)
        );

      allow update: if signedIn()
        && (
          resource.data.email == authEmail()
          || canManageTeam(resource.data.weddingId)
        )
        && request.resource.data.weddingId == resource.data.weddingId
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;

      allow delete: if signedIn()
        && (
          resource.data.email == authEmail()
          || canManageTeam(resource.data.weddingId)
        );
    }

    // Configuración pública del formulario RSVP. El token largo funciona como
    // enlace no enumerado; solo se puede leer públicamente mientras esté activo.
    match /publicRsvp/{token} {
      allow read: if resource.data.get('active', false) == true
        || (signedIn() && hasActiveMembership(resource.data.get('weddingId', '')));

      allow create: if signedIn()
        && canEditPlanner(request.resource.data.get('weddingId', ''));

      allow update, delete: if signedIn()
        && canEditPlanner(resource.data.get('weddingId', ''));

      match /responses/{responseId} {
        // RSVP y Música son formularios visualmente independientes, pero usan
        // el mismo responseId. Música puede llegar primero y RSVP completar
        // posteriormente ese mismo documento.
        allow create: if anonymousRsvpUser()
          && publicRsvpActive(token)
          && (
            validRsvpSubmission(token)
            || validMusicOnlySubmission(token)
          );

        allow update: if (
            anonymousRsvpUser()
            && publicRsvpActive(token)
            && resource.data.ownerUid is string
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'version', 'name', 'attendance', 'quantity', 'companions',
              'menu', 'email', 'phone', 'restriction', 'notes', 'customData',
              'clientDate', 'source', 'updatedAt'
            ])
            && (
              validRsvpSubmission(token)
              || validMusicOnlySubmission(token)
            )
          ) || (
            signedIn()
            && canEditPlanner(publicRsvpWedding(token))
          );

        // Las respuestas nunca son legibles públicamente. Las nuevas usan
        // ownerUid; las históricas sin ownerUid solo admiten edición administrativa.
        allow read: if signedIn()
          && hasActiveMembership(publicRsvpWedding(token));

        allow delete: if signedIn()
          && canEditPlanner(publicRsvpWedding(token));
      }
    }
  }
}

