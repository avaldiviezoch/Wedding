{
  "name": "mi-gran-dia-repository-validation",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-repository.mjs",
    "validate:update-baseline": "node scripts/validate-repository.mjs --update-baseline",
    "test:firestore": "firebase emulators:exec --project demo-mi-gran-dia --only firestore \"node --test tests/firestore/firestore.rules.test.mjs\"",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "test": "npm run validate && npm run test:backend && npm run test:firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^12.2.1",
    "firebase-tools": "^14.15.2"
  },
  "engines": {
    "node": ">=20"
  }
}

